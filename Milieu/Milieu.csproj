<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Dalamud.NET.Sdk" />

  <PropertyGroup>
    <!-- yyMM.<commit count>, computed in Directory.Build.props (ComputeMilieuVersion). -->
    <Version>$(MilieuVersion)</Version>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Name>Milieu</Name>
    <Author>Solona</Author>
    <Punchline>Swap the backdrop for an HDRI panorama</Punchline>
    <Description>Projects an HDRI or panorama image onto a sky dome around you, for screenshots and venues. A large dome for outdoor skies, a small one for room interiors.&#xA;&#xA;Type /milieu to open it.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Tags>hdri;skybox;backdrop;gpose;screenshot;vfx</Tags>
    <CategoryTags>utility</CategoryTags>
    <RepoUrl>https://github.com/solona-m/milieu</RepoUrl>
    <!-- Dalamud reads images\icon.png next to the DLL for dev plugins only; an installed plugin's icon comes from this
         URL in its manifest. The dl.solona.info worker serves Milieu/images/icon.png from the test branch at it, the same
         URL the solona-m/plugins listing uses (the sync drops the manifest's IconUrl and sets its own), so both agree
         without a main merge (docs/adr/0007-plugin-releases-and-listing.md). -->
    <IconUrl>https://dl.solona.info/milieu/icon.png</IconUrl>
    <!-- Shown under the plugin entry after an update. Deliberately empty here: the value comes from the annotated tag's
         message, which the release workflows put in a Changelog environment variable before building (MSBuild surfaces
         environment variables as properties, and this Condition yields to one when set). Hardcoded text would ship the
         same stale line on every later release; an absent changelog is honest, a wrong one is not. -->
    <Changelog Condition="'$(Changelog)' == ''"></Changelog>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lands at bin\...\images\icon.png, where Dalamud looks for a dev plugin's icon. Square, at most 512x512. -->
    <None Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Plain versions (no floats or ranges), the same ones Proteus ships, so packages.lock.json stays a reviewable diff. -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Milieu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 256x128 previews of the bundled scenes (tools/PrepareBackdrops thumbs), embedded so the grid shows before any download. -->
    <EmbeddedResource Include="Resources\Thumbs\*.jpg" LogicalName="Milieu.Resources.Thumbs.%(Filename).jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The bundled backdrops are NOT shipped in the plugin zip: they are pre-converted, published as pinned release assets
         under a backdrops-v<N> tag by tools/publish-backdrops.ps1 (docs/adr/0005) and downloaded on demand by
         DefaultBackdropsDownloadService. The release workflows' package check fails a zip over 4 MB. -->
    <None Remove="DefaultBackdrops\**" />
    <Content Remove="DefaultBackdrops\**" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Dalamud.NET.Sdk" />
</Project>
